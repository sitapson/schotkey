{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.sctelemetry.deck",
  "Name": "SC Telemetry Deck",
  "Author": "SC Telemetry Deck",
  "Description": "Hotkeys for Star Citizen whose icons follow the game's live telemetry.",
  "Version": "0.1.0.0",
  "Category": "SC Telemetry Deck",
  "CategoryIcon": "imgs/plugin/category",
  "Icon": "imgs/plugin/icon",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "SC Hotkey",
      "UUID": "com.sctelemetry.deck.hotkey",
      "Icon": "imgs/actions/hotkey/icon",
      "Tooltip": "Sends a key combo; the icon follows a telemetry field.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/hotkey.html",
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/hotkey/key",
          "ShowTitle": true
        }
      ]
    },
    {
      "Name": "Telemetry Status",
      "UUID": "com.sctelemetry.deck.status",
      "Icon": "imgs/actions/status/icon",
      "Tooltip": "Shows whether the telemetry feed is live. Press to save a snapshot of every field.",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/status/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "SC Gauge",
      "UUID": "com.sctelemetry.deck.gauge",
      "Icon": "imgs/actions/gauge/icon",
      "Tooltip": "Segmented ring gauge for a telemetry value, e.g. hydrogen or quantum fuel.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/gauge.html",
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/gauge/key",
          "ShowTitle": false
        }
      ]
    }
  ]
}